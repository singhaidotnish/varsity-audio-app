{
  "manifest_version": 3,
  "name": "Varsity Audio",
  "version": "1.0",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
  "https://zerodha.com/varsity/*",
  "https://varsity-audio-monorepo-cjpj.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://zerodha.com/varsity/chapter/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}